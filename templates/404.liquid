<div id="smart-router-loading" style="min-height: 80vh; background: #FFFFFF; display: flex; align-items: center; justify-content: center;">
  <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; color: #5CC5CB; font-style: italic; letter-spacing: 0.05em;">Loading Desura De Sehr...</div>
</div>

<!-- 1. Default 404 Page Container -->
<div id="router-404-container" style="display: none;">
  <div class="page-404">
    <div class="page-404-inner">
      <p class="page-404-code">404</p>
      <h1 class="page-404-title">Page not found</h1>
      <p class="page-404-body">The page you were looking for does not exist.</p>
      <a href="{{ routes.root_url }}" class="cta-btn">
        <span class="cta-text">BACK TO HOME</span>
        <span class="cta-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<!-- 2. Fallback Section Containers -->
<div id="router-about-container" style="display: none;">
  {% section 'main-about' %}
</div>

<div id="router-cart-container" style="display: none;">
  {% section 'main-cart' %}
</div>

<div id="router-contact-container" style="display: none;">
  {% section 'main-contact' %}
</div>

<div id="router-shipping-container" style="display: none;">
  {% section 'main-shipping' %}
</div>

<div id="router-privacy-container" style="display: none;">
  {% section 'main-privacy' %}
</div>

<div id="router-wishlist-container" style="display: none;">
  {% section 'main-wishlist' %}
</div>

<script>
  (function() {
    const path = window.location.pathname.toLowerCase();
    const loading = document.getElementById('smart-router-loading');
    
    let matchedId = 'router-404-container';

    if (path.indexOf('wish') > -1 || path.indexOf('favor') > -1 || path.indexOf('save') > -1 || path.indexOf('like') > -1) {
      matchedId = 'router-wishlist-container';
    } else if (path.indexOf('about') > -1) {
      matchedId = 'router-about-container';
    } else if (path.indexOf('cart') > -1) {
      matchedId = 'router-cart-container';
    } else if (path.indexOf('contact') > -1) {
      matchedId = 'router-contact-container';
    } else if (path.indexOf('shipping') > -1 || path.indexOf('return') > -1 || path.indexOf('refund') > -1 || path.indexOf('delivery') > -1) {
      matchedId = 'router-shipping-container';
    } else if (path.indexOf('privacy') > -1) {
      matchedId = 'router-privacy-container';
    }

    // Hide loader and show matched container
    if (loading) loading.style.display = 'none';
    const container = document.getElementById(matchedId);
    if (container) {
      container.style.display = 'block';
    }
  })();
</script>

<style>
  .page-404 {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', system-ui, sans-serif;
    padding-top: 64px;
    background-color: #FFFFFF;
  }
  .page-404-inner { text-align: center; }
  .page-404-code {
    font-size: 120px;
    font-weight: 300;
    color: #5CC5CB;
    line-height: 1;
    opacity: 0.6;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .page-404-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 48px;
    font-weight: 300;
    color: #000000;
    margin-bottom: 16px;
  }
  .page-404-body {
    font-size: 15px;
    color: #666666;
    margin-bottom: 32px;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #000000;
    color: #FFFFFF;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    transition: background 0.3s ease;
  }
  .cta-btn:hover {
    background: #5CC5CB;
  }
</style>
