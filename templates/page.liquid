{%- assign handle_down = page.handle | downcase -%}
{%- assign title_down = page.title | downcase -%}
{%- assign path_down = request.path | downcase -%}

{%- if handle_down contains 'wishlist' or handle_down contains 'favorite' or handle_down contains 'favourite' or handle_down contains 'saved' or title_down contains 'wishlist' or title_down contains 'favorite' or path_down contains 'wish' or path_down contains 'favor' -%}
  {% section 'main-wishlist' %}
{%- elsif handle_down contains 'contact' or title_down contains 'contact' or path_down contains 'contact' -%}
  {% section 'main-contact' %}
{%- elsif handle_down contains 'faq' or title_down contains 'faq' or path_down contains 'faq' -%}
  {% section 'main-faq' %}
{%- elsif handle_down contains 'return' or handle_down contains 'refund' or title_down contains 'return' or title_down contains 'refund' or path_down contains 'return' or path_down contains 'refund' -%}
  {% section 'main-returns' %}
{%- elsif handle_down contains 'shipping' or handle_down contains 'delivery' or title_down contains 'shipping' or path_down contains 'shipping' -%}
  {% section 'main-shipping' %}
{%- elsif handle_down contains 'privacy' or title_down contains 'privacy' or path_down contains 'privacy' -%}
  {% section 'main-privacy' %}
{%- elsif handle_down contains 'about' or title_down contains 'about' or path_down contains 'about' -%}
  {% section 'main-about' %}
{%- else -%}
  {% section 'main-about' %}
{%- endif -%}
