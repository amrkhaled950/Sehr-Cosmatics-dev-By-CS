    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ptop-text h3 {
    font-size: 13px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 4px 0;
