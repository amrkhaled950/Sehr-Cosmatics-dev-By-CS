    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .pquestions-title-wrap {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .pquestions-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pquestions-text h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 28px;
    font-weight: 500;
    color: #000000;
    margin: 0 0 2px 0;
  }

  .pquestions-text p {
    font-size: 12px;
    color: #777777;
    margin: 0;
  }

  .pquestions-contacts {
    display: flex;
    align-items: center;
