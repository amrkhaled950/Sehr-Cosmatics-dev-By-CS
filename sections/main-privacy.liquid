  }

  /* Responsive */
  @media (max-width: 1200px) {
    .privacy-top-grid,
    .sec2-cards-5col {
      grid-template-columns: repeat(3, 1fr);
    }
    .sec3-cards-4col,
    .sec4to7-grid-4col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .sec1-cards-2col {
      grid-template-columns: 1fr;
    }
    .privacy-top-grid,
    .sec2-cards-5col {
      grid-template-columns: repeat(2, 1fr);
    }
    .privacy-questions-grid {
      flex-direction: column;
      align-items: flex-start;
    }
    .pquestions-contacts {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .main-privacy-section {
      padding: 90px 20px 60px;
    }
  }

  /* ── Scroll Animations ── */
  [data-reveal] {
    opacity: 0;
    transition-property: transform, opacity, filter, box-shadow;
    transition-duration: 0.85s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  [data-reveal="fade-up"] {
    transform: translateY(30px);
  }

  [data-reveal="scale-x"] {
    transform: scaleX(0);
    transform-origin: center;
  }

  [data-reveal="card-3d"] {
    transform: perspective(1000px) rotateX(10deg) translateY(30px);
  }

  [data-reveal="promise-card"] {
    transform: translateY(35px) scale(0.97);
  }

  /* Revealed Active States */
  [data-reveal].is-in-view {
    opacity: 1;
    transform: none;
  }

  [data-reveal="scale-x"].is-in-view {
    transform: scaleX(1);
    opacity: 1;
  }

  [data-reveal="promise-card"].is-in-view {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const revealElements = document.querySelectorAll('#main-privacy-{{ section.id }} [data-reveal]');
    if (!revealElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const delay = el.getAttribute('data-delay') || 0;
          setTimeout(() => {
            el.classList.add('is-in-view');
          }, parseInt(delay));
          observer.unobserve(el);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  });
</script>

