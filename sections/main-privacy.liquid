<style>
  /* ═══════════════════════════════════════════════════
     MAIN PRIVACY SECTION STYLES — #000000 & #5CC5CB
  ═══════════════════════════════════════════════════ */

  .main-privacy-section {
    width: 100%;
    padding: 120px 48px 100px;
    background-color: #FFFFFF;
    font-family: 'Inter', system-ui, sans-serif;
