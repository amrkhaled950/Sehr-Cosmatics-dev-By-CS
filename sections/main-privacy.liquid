{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<section class="main-privacy-section" id="main-privacy-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="privacy-container">

    <!-- ── Page Header Area ── -->
    <div class="privacy-header">
      <h1 class="privacy-title" data-reveal="fade-up" data-delay="0">
        {% if is_arabic %}{{ section.settings.title_ar | default: 'سياسة الخصوصية' }}{% else %}{{ section.settings.title_en | default: 'Privacy Policy' }}{% endif %}
      </h1>
      <div class="privacy-title-line" data-reveal="scale-x" data-delay="100"></div>
      <p class="privacy-subtitle" data-reveal="fade-up" data-delay="200">
        {% if is_arabic %}
          في Desura De Sehr، نحن نثمن ثقتك ونلتزم بحماية معلوماتك الشخصية وحقك في الخصوصية.
        {% else %}
          At Desura De Sehr, we value your trust and are committed to protecting your personal information and your right to privacy.
        {% endif %}
      </p>
    </div>

    <!-- ── Top 5 Pillars Bar (White Card) ── -->
    <div class="privacy-top-bar" data-reveal="promise-card" data-delay="100">
      <div class="privacy-top-grid">
        
        <div class="ptop-item" data-reveal="fade-up" data-delay="0">
          <div class="ptop-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="ptop-text">
            <h3>{% if is_arabic %}خصوصيتك تهمنا{% else %}Your Privacy Matters{% endif %}</h3>
            <p>{% if is_arabic %}نحمي بياناتك الشخصية بعناية ومسؤولية تامة.{% else %}We protect your personal data with care and responsibility.{% endif %}</p>
          </div>
        </div>

        <div class="ptop-item" data-reveal="fade-up" data-delay="80">
          <div class="ptop-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div class="ptop-text">
            <h3>{% if is_arabic %}آمن ومحمي{% else %}Secure & Protected{% endif %}</h3>
            <p>{% if is_arabic %}نستخدم معايير الأمان العالمية للحفاظ على أمان معلوماتك.{% else %}We use industry-standard measures to keep your information safe.{% endif %}</p>
          </div>
        </div>

        <div class="ptop-item" data-reveal="fade-up" data-delay="160">
          <div class="ptop-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="ptop-text">
            <h3>{% if is_arabic %}أنت في كامل التحكم{% else %}You're in Control{% endif %}</h3>
            <p>{% if is_arabic %}يمكنك إدارة تفضيلاتك وبياناتك في أي وقت.{% else %}You can manage your preferences and data at any time.{% endif %}</p>
          </div>
        </div>

        <div class="ptop-item" data-reveal="fade-up" data-delay="240">
          <div class="ptop-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div class="ptop-text">
            <h3>{% if is_arabic %}ممارسات شفافة{% else %}Transparent Practices{% endif %}</h3>
            <p>{% if is_arabic %}نؤمن بالتواصل الواضح والشفاف حول كيفية استخدام بياناتك.{% else %}We believe in clear communication about how we use your data.{% endif %}</p>
          </div>
        </div>

        <div class="ptop-item" data-reveal="fade-up" data-delay="320">
          <div class="ptop-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div class="ptop-text">
            <h3>{% if is_arabic %}معايير عالمية{% else %}Global Standards{% endif %}</h3>
            <p>{% if is_arabic %}تتوافق ممارساتنا مع قوانين ولوائح الخصوصية المعمول بها.{% else %}Our practices comply with applicable privacy laws and regulations.{% endif %}</p>
          </div>
        </div>

      </div>
    </div>

    <!-- ── SECTION 1: Information We Collect ── -->
    <div class="privacy-section-block">
      <div class="section-heading-centered" data-reveal="fade-up">
        <h2 class="sec-title">1. {% if is_arabic %}المعلومات التي نجمعها{% else %}Information We Collect{% endif %}</h2>
        <div class="sec-title-line" data-reveal="scale-x"></div>
      </div>

      <div class="sec1-cards-2col">
        <!-- Personal Information Card -->
        <div class="pcard">
          <div class="pcard-header">
            <div class="pcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <h3>{% if is_arabic %}المعلومات الشخصية{% else %}Personal Information{% endif %}</h3>
          </div>
          
          <p class="pcard-intro">{% if is_arabic %}قد نجمع المعلومات الشخصية التي تزودنا بها، مثل:{% else %}We may collect personal information that you provide to us, such as:{% endif %}</p>
          
          <ul class="pcard-list">
            <li>{% if is_arabic %}الاسم، البريد الإلكتروني، ورقم الهاتف{% else %}Name, email address, phone number{% endif %}</li>
            <li>{% if is_arabic %}عنوان الشحن والدفع{% else %}Shipping and billing address{% endif %}</li>
            <li>{% if is_arabic %}تفاصيل تسجيل الدخول للحساب{% else %}Account login details{% endif %}</li>
            <li>{% if is_arabic %}معلومات الدفع والتسديد{% else %}Payment information{% endif %}</li>
          </ul>

          <p class="pcard-subtext">{% if is_arabic %}تُجمع هذه المعلومات عندما تقوم بإنشاء حساب، إجراء طلب، التواصل معنا، أو الاشتراك في النشرة الإخبارية.{% else %}This information is collected when you create an account, place an order, contact us, or subscribe to our newsletter.{% endif %}</p>
        </div>

        <!-- Non-Personal Information Card -->
        <div class="pcard">
          <div class="pcard-header">
            <div class="pcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3>{% if is_arabic %}المعلومات غير الشخصية{% else %}Non-Personal Information{% endif %}</h3>
          </div>
          
          <p class="pcard-intro">{% if is_arabic %}قد نجمع أيضاً معلومات غير شخصية تلقائياً، مثل:{% else %}We may also collect non-personal information automatically, such as:{% endif %}</p>
          
          <ul class="pcard-list">
            <li>{% if is_arabic %}نوع المتصفح ومعلومات الجهاز{% else %}Browser type and device information{% endif %}</li>
            <li>{% if is_arabic %}عنوان IP وبيانات الموقع الجغرافي{% else %}IP address and location data{% endif %}</li>
            <li>{% if is_arabic %}الصفحات المزورة والوقت المستغرق على الموقع{% else %}Pages visited and time spent on our site{% endif %}</li>
            <li>{% if is_arabic %}موقع الإحالة أو المصدر{% else %}Referring website or source{% endif %}</li>
          </ul>

          <p class="pcard-subtext">{% if is_arabic %}يساعدنا هذا في تحسين موقعنا الإلكتروني، خدماتنا، وتجربة العملاء.{% else %}This helps us improve our website, services, and customer experience.{% endif %}</p>
        </div>
      </div>
    </div>

    <!-- ── SECTION 2: How We Use Your Information ── -->
    <div class="privacy-section-block">
      <div class="section-heading-centered">
        <h2 class="sec-title">2. {% if is_arabic %}كيف نستخدم معلوماتك{% else %}How We Use Your Information{% endif %}</h2>
        <div class="sec-title-line"></div>
      </div>

      <div class="sec2-cards-5col">
        <!-- Item 1 -->
        <div class="mini-use-card">
          <div class="use-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3>{% if is_arabic %}معالجة الطلبات{% else %}To Process Orders{% endif %}</h3>
          <p>{% if is_arabic %}لمعالجة وتوصيل طلباتك وإدارة حسابك.{% else %}To process and deliver your orders and manage your account.{% endif %}</p>
        </div>

        <!-- Item 2 -->
        <div class="mini-use-card">
          <div class="use-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3>{% if is_arabic %}التواصل معك{% else %}To Communicate{% endif %}</h3>
          <p>{% if is_arabic %}لإرسال تحديثات الطلبات، الرد على الاستفسارات، ومشاركة المعلومات المهمة.{% else %}To send order updates, respond to inquiries, and share important information.{% endif %}</p>
        </div>

        <!-- Item 3 -->
        <div class="mini-use-card">
          <div class="use-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h3>{% if is_arabic %}تحسين خدماتنا{% else %}To Improve Our Services{% endif %}</h3>
          <p>{% if is_arabic %}لتحديد كيفية استخدام الموقع وتحسين منتجاتنا وخدماتنا وتجربة المستخدم.{% else %}To analyze website usage and improve our products, services, and user experience.{% endif %}</p>
        </div>

        <!-- Item 4 -->
        <div class="mini-use-card">
          <div class="use-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>{% if is_arabic %}تخصيص التجربة{% else %}To Personalize{% endif %}</h3>
          <p>{% if is_arabic %}لتخصيص تجربتك وعرض المنتجات والعروض المناسبة لك.{% else %}To personalize your experience and show relevant products and offers.{% endif %}</p>
        </div>

        <!-- Item 5 -->
        <div class="mini-use-card">
          <div class="use-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M12 3v18M3 12h18"/></svg>
          </div>
          <h3>{% if is_arabic %}الامتثال للقوانين{% else %}To Comply with Law{% endif %}</h3>
          <p>{% if is_arabic %}للإمتثال للالتزامات القانونية ومنع الاحتيال أو الأنشطة غير القانونية.{% else %}To comply with legal obligations and prevent fraud or unlawful activity.{% endif %}</p>
        </div>
      </div>
    </div>

    <!-- ── SECTION 3: Information Sharing ── -->
    <div class="privacy-section-block">
      <div class="section-heading-centered">
        <h2 class="sec-title">3. {% if is_arabic %}مشاركة المعلومات{% else %}Information Sharing{% endif %}</h2>
        <div class="sec-title-line"></div>
      </div>

      <p class="sec-intro-text">
        {% if is_arabic %}
          نحن لا نبيع أو نؤجر معلوماتك الشخصية. قد نشارك معلوماتك فقط في الحالات التالية:
        {% else %}
          We do not sell or rent your personal information. We may share your information only in the following cases:
        {% endif %}
      </p>

      <div class="sec3-cards-4col">
        <!-- Card 1 -->
        <div class="share-card">
          <div class="share-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>{% if is_arabic %}مزودو الخدمات{% else %}Service Providers{% endif %}</h3>
          <p>{% if is_arabic %}مع موفري الخدمات الموثوقين من الأطراف الثالثة الذين يساعدوننا في تشغيل موقعنا وأعمالنا.{% else %}With trusted third-party service providers who help us operate our website and business.{% endif %}</p>
        </div>

        <!-- Card 2 -->
        <div class="share-card">
          <div class="share-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </div>
          <h3>{% if is_arabic %}معالجو المعاملات المالية{% else %}Payment Processors{% endif %}</h3>
          <p>{% if is_arabic %}مع بوابات الدفع الآمنة لمعالجة معاملاتك المالية بكل أمان.{% else %}With secure payment gateways to process your transactions safely.{% endif %}</p>
        </div>

        <!-- Card 3 -->
        <div class="share-card">
          <div class="share-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>{% if is_arabic %}المتطلبات القانونية{% else %}Legal Requirements{% endif %}</h3>
          <p>{% if is_arabic %}عندما يقتضي القانون ذلك أو لحماية حقوقنا وممتلكاتنا وسلامتنا.{% else %}When required by law or to protect our rights, property, and safety.{% endif %}</p>
        </div>

        <!-- Card 4 -->
        <div class="share-card">
          <div class="share-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          </div>
          <h3>{% if is_arabic %}نقل الأعمال والأنشطة{% else %}Business Transfers{% endif %}</h3>
          <p>{% if is_arabic %}في حالة الاندماج، الاستحواذ، أو بيع الأصول.{% else %}In the event of a merger, acquisition, or sale of assets.{% endif %}</p>
        </div>
      </div>
    </div>

    <!-- ── SECTIONS 4, 5, 6, 7 GRID ── -->
    <div class="privacy-section-block">
      <div class="sec4to7-grid-4col">
        
        <!-- 4. Your Rights -->
        <div class="grid-policy-card">
          <div class="gcard-header">
            <div class="gcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <h3>4. {% if is_arabic %}حقوقك{% else %}Your Rights{% endif %}</h3>
          </div>
          <p class="gcard-intro">{% if is_arabic %}لديك الحق في:{% else %}You have the right to:{% endif %}</p>
          <ul class="gcard-bullets">
            <li>{% if is_arabic %}الوصول إلى البيانات الشخصية التي نحتفظ بها عنك{% else %}Access the personal data we hold about you{% endif %}</li>
            <li>{% if is_arabic %}تصحيح البيانات غير الدقيقة أو غير الكرتملة{% else %}Correct inaccurate or incomplete data{% endif %}</li>
            <li>{% if is_arabic %}طلب حذف بياناتك الشخصية{% else %}Request deletion of your data{% endif %}</li>
            <li>{% if is_arabic %}إلغاء الاشتراك في الاتصالات التسويقية{% else %}Opt out of marketing communications{% endif %}</li>
          </ul>
          <p class="gcard-subtext">{% if is_arabic %}لممارسة حقوقك، تواصل معنا في أي وقت.{% else %}To exercise your rights, contact us anytime.{% endif %}</p>
        </div>

        <!-- 5. Data Security -->
        <div class="grid-policy-card">
          <div class="gcard-header">
            <div class="gcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3>5. {% if is_arabic %}أمان البيانات{% else %}Data Security{% endif %}</h3>
          </div>
          <p class="gcard-body">{% if is_arabic %}نطبق الإجراءات الفنية والتنظيمية المناسبة لحماية معلوماتك الشخصية من الوصول غير المصرح به، التعديل، الإفصاح، أو التدمير.{% else %}We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction.{% endif %}</p>
        </div>

        <!-- 6. Cookies -->
        <div class="grid-policy-card">
          <div class="gcard-header">
            <div class="gcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 0 10 10"/></svg>
            </div>
            <h3>6. {% if is_arabic %}ملفات تعريف الارتباط (Cookies){% else %}Cookies{% endif %}</h3>
          </div>
          <p class="gcard-body">{% if is_arabic %}نستخدم ملفات تعريف الارتباط لتحسين تجربتك. يمكنك إدارة أو تعطيل ملفات تعريف الارتباط من خلال إعدادات المتصفح الخاص بك.{% else %}We use cookies to enhance your experience. You can manage or disable cookies through your browser settings.{% endif %}</p>
          <a href="/pages/privacy-policy" class="gcard-link">{% if is_arabic %}اعرف المزيد في سياسة الكوكيز{% else %}Learn more in our Cookie Policy.{% endif %}</a>
        </div>

        <!-- 7. Changes to This Policy -->
        <div class="grid-policy-card">
          <div class="gcard-header">
            <div class="gcard-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <h3>7. {% if is_arabic %}التغييرات على هذه السياسة{% else %}Changes to This Policy{% endif %}</h3>
          </div>
          <p class="gcard-body">{% if is_arabic %}قد نقوم بتحديث سياسة الخصوصية هذه من وقت لآخر. سيتم نشر التغييرات على هذه الصفحة مع تاريخ النفاذ المحدث.{% else %}We may update this Privacy Policy from time to time. Changes will be posted on this page with the updated effective date.{% endif %}</p>
        </div>

      </div>
    </div>

    <!-- ── QUESTIONS ABOUT YOUR PRIVACY? BAR ── -->
    <div class="privacy-questions-card">
      <div class="privacy-questions-grid">
        <div class="pquestions-title-wrap">
          <div class="pquestions-icon">
