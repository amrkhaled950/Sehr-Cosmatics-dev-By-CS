{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<section class="science-ingredients-section" id="science-ingredients-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="science-container">
    
    <!-- Left Column: Section Typography Header -->
    <div class="science-header">
      <span class="science-eyebrow">
        {%- if is_arabic -%}
          {{ section.settings.eyebrow_ar | default: 'العلم والطبيعة' }}
        {%- else -%}
          {{ section.settings.eyebrow_en | default: 'THE SCIENCE WITHIN' }}
        {%- endif -%}
      </span>

      <h2 class="science-title">
        {%- if is_arabic -%}
          <span class="title-line">{{ section.settings.heading_line1_ar | default: 'أفضل ما في الطبيعة.' }}</span>
          <span class="title-line">{{ section.settings.heading_line2_ar | default: 'مدعوم بـ' }}</span>
          <span class="title-accent">{{ section.settings.heading_accent_ar | default: 'العلم.' }}</span>
        {%- else -%}
          <span class="title-line">{{ section.settings.heading_line1_en | default: 'Nature’s Best.' }}</span>
          <span class="title-line">{{ section.settings.heading_line2_en | default: 'Backed by' }}</span>
          <span class="title-accent">{{ section.settings.heading_accent_en | default: 'Science.' }}</span>
        {%- endif -%}
      </h2>

      <p class="science-description">
        {%- if is_arabic -%}
          {{ section.settings.body_ar | default: 'نجمع بين المكونات الطبيعية القوية والعلم المتقدم لتقديم نتائج ملحوظة وتدوم طويلاً.' }}
        {%- else -%}
          {{ section.settings.body_en | default: 'We combine powerful natural ingredients with advanced science to deliver visible, lasting results.' }}
        {%- endif -%}
      </p>
    </div>

    <!-- Right Column: Interactive Glowing Ingredient Spheres -->
    <div class="science-spheres-grid">
      {%- for block in section.blocks -%}
        <div class="sphere-item" {{ block.shopify_attributes }}>
          
          <div class="sphere-media-wrap">
            <div class="sphere-glow-effect" style="--glow-color: {{ block.settings.glow_color | default: 'rgba(99, 201, 207, 0.35)' }};" aria-hidden="true"></div>
            
            <div class="sphere-img-box">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | img_url: '400x400' }}" alt="{{ block.settings.title_en | escape }}" loading="lazy" class="sphere-img" />
              {%- else -%}
                {%- assign fallback_index = forloop.index | minus: 1 | modulo: 5 | plus: 1 -%}
                {%- assign fallback_asset = 'ingredient-' | append: fallback_index | append: '.jpg' -%}
                <img src="{{ fallback_asset | asset_url }}" alt="{{ block.settings.title_en | escape }}" loading="lazy" class="sphere-img" />
              {%- endif -%}
            </div>
          </div>

          <div class="sphere-content">
            <h3 class="sphere-title">
              {%- if is_arabic -%}
                {{ block.settings.title_ar | default: block.settings.title_en }}
              {%- else -%}
                {{ block.settings.title_en }}
              {%- endif -%}
            </h3>
            <p class="sphere-subtitle">
              {%- if is_arabic -%}
                {{ block.settings.subtitle_ar | default: block.settings.subtitle_en }}
              {%- else -%}
                {{ block.settings.subtitle_en }}
              {%- endif -%}
            </p>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════
     SCIENCE & INGREDIENTS SECTION STYLES
     ═══════════════════════════════════════════════════════ */
  .science-ingredients-section {
    position: relative;
    width: 100%;
    padding: 100px 48px;
    background: linear-gradient(180deg, #f8fdfd 0%, #ffffff 100%);
    overflow: hidden;
  }

  .science-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 60px;
    align-items: center;
  }

  /* Left Header Typography */
  .science-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .science-eyebrow {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #5cc5cb;
    text-transform: uppercase;
  }

  .science-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 48px;
    line-height: 1.05;
    font-weight: 500;
    color: #1a1a1a;
    margin: 0;
  }

  .science-title .title-line {
    display: block;
  }

  .science-title .title-accent {
    font-style: italic;
    color: #5cc5cb;
    font-weight: 400;
    display: block;
  }

  .science-description {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: #666666;
    margin-top: 8px;
  }

  /* Right Spheres Grid */
  .science-spheres-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    align-items: flex-start;
  }

  .sphere-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sphere-media-wrap {
    position: relative;
    width: 130px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .sphere-glow-effect {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow-color, rgba(99, 201, 207, 0.35)) 0%, transparent 70%);
    opacity: 0.6;
    filter: blur(12px);
    transition: all 0.4s ease;
    pointer-events: none;
  }

  .sphere-img-box {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .sphere-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .sphere-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.4s ease;
  }

  .sphere-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #222222;
    text-transform: uppercase;
    margin: 0;
  }

  .sphere-subtitle {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    line-height: 1.4;
    color: #777777;
    margin: 0;
  }

  /* ── Hover Micro-Animations ── */
  .sphere-item:hover {
    transform: translateY(-8px);
  }

  .sphere-item:hover .sphere-img-box {
    transform: scale(1.08);
    box-shadow: 0 20px 40px rgba(99, 201, 207, 0.3);
  }

  .sphere-item:hover .sphere-img {
    transform: scale(1.05);
  }

  .sphere-item:hover .sphere-glow-effect {
    opacity: 1;
    inset: -18px;
    filter: blur(18px);
  }

  .sphere-item:hover .sphere-content {
    transform: translateY(-2px);
  }

  .sphere-item:hover .sphere-title {
    color: #5cc5cb;
  }

  /* Responsive Layout */
  @media (max-width: 1200px) {
    .science-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .science-spheres-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .science-ingredients-section {
      padding: 60px 24px;
    }
    .science-spheres-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .science-title {
      font-size: 36px;
    }
    .sphere-media-wrap {
      width: 100px;
      height: 100px;
    }
  }
</style>

