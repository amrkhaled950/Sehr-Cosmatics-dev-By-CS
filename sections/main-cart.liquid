{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<section class="main-cart-section" id="main-cart-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="cart-container">
    
    <!-- Page Header -->
    <div class="cart-header">
      <span class="cart-eyebrow">
        {% if is_arabic %}سلة التسوق{% else %}YOUR SHOPPING BAG{% endif %}
      </span>
      <h1 class="cart-title">
        {% if is_arabic %}حقيبة <em>التسوق</em>{% else %}Your <em>Cart</em>{% endif %}
      </h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="/cart" method="post" novalidate class="cart-form">
        <div class="cart-layout-grid">
          
          <!-- Left Column: Items List -->
          <div class="cart-items-col">
            <div class="cart-table-header">
              <span>{% if is_arabic %}المنتج{% else %}PRODUCT{% endif %}</span>
              <span>{% if is_arabic %}الكمية{% else %}QUANTITY{% endif %}</span>
              <span>{% if is_arabic %}الإجمالي{% else %}TOTAL{% endif %}</span>
            </div>

            <div class="cart-items-list">
              {%- for item in cart.items -%}
                <div class="cart-item-row" data-cart-item-id="{{ item.id }}">
                  
                  <!-- Item Product Info -->
                  <div class="cart-item-info">
                    <a href="{{ item.url }}" class="cart-item-img-wrap">
                      {%- if item.image != blank -%}
                        <img
                          src="{{ item.image | img_url: '200x200', crop: 'center' }}"
                          alt="{{ item.title | escape }}"
                          loading="lazy"
                        />
                      {%- else -%}
                        <div class="cart-img-placeholder">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M21 15l-5-5L5 21"/></svg>
                        </div>
                      {%- endif -%}
                    </a>

                    <div class="cart-item-details">
                      <a href="{{ item.url }}" class="cart-item-title">
                        {{ item.product.title }}
                      </a>

                      {%- unless item.product.has_only_default_variant -%}
                        <span class="cart-item-variant">{{ item.variant.title }}</span>
                      {%- endunless -%}

                      <div class="cart-item-price-mobile">
                        {{ item.final_price | money }}
                      </div>

                      <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="cart-item-remove-btn" aria-label="Remove item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span>{% if is_arabic %}إزالة{% else %}Remove{% endif %}</span>
                      </a>
                    </div>
                  </div>

                  <!-- Item Quantity -->
                  <div class="cart-item-qty">
                    <div class="cart-qty-control">
                      <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="cart-qty-btn" aria-label="Decrease quantity">—</a>
                      <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="cart-qty-input" />
                      <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="cart-qty-btn" aria-label="Increase quantity">+</a>
                    </div>
                  </div>

                  <!-- Item Line Total -->
                  <div class="cart-item-total">
                    {{ item.final_line_price | money }}
                  </div>

                </div>
              {%- endfor -%}
            </div>

            <div class="cart-col-actions">
              <a href="/collections/all" class="cart-continue-btn">
                ← {% if is_arabic %}متابعة التسوق{% else %}CONTINUE SHOPPING{% endif %}
              </a>
              <button type="submit" name="update" class="cart-update-btn">
                {% if is_arabic %}تحديث السلة{% else %}UPDATE CART{% endif %}
              </button>
            </div>

          </div>

          <!-- Right Column: Order Summary -->
          <div class="cart-summary-col">
            <div class="cart-summary-card">
              <h3 class="cart-summary-title">
                {% if is_arabic %}ملخص الطلب{% else %}ORDER SUMMARY{% endif %}
              </h3>

              <div class="cart-summary-row">
                <span>{% if is_arabic %}المجموع الفرعي{% else %}Subtotal{% endif %}</span>
                <span class="summary-subtotal-price">{{ cart.total_price | money }}</span>
              </div>

              <div class="cart-summary-note">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <span>{% if is_arabic %}الضرائب والشحن يتم حسابها عند الدفع{% else %}Taxes and shipping calculated at checkout.{% endif %}</span>
              </div>

              <button type="submit" name="checkout" class="cart-checkout-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>{% if is_arabic %}إتمام الشراء{% else %}PROCEED TO CHECKOUT{% endif %}</span>
              </button>

              <div class="cart-secure-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>{% if is_arabic %}دفع آمن ومشفر 100%{% else %}100% Guaranteed Safe Checkout{% endif %}</span>
              </div>
            </div>
          </div>

        </div>
      </form>

    {%- else -%}
      <!-- Empty Cart State -->
      <div class="cart-empty-box">
        <div class="cart-empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </div>
        <h2>{% if is_arabic %}سلة التسوق فارغة حالياً{% else %}Your shopping bag is empty{% endif %}</h2>
        <p>{% if is_arabic %}لم تقم بإضافة أي منتجات بعد. تصفح مجموعاتنا واكتشف الأفضل لك.{% else %}You haven't added any products to your cart yet. Explore our collection to find your beauty rituals.{% endif %}</p>
        <a href="/collections/all" class="cart-empty-shop-btn">
          {% if is_arabic %}تصفح المنتجات{% else %}DISCOVER OUR PRODUCTS{% endif %} →
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════
     MAIN CART SECTION STYLES — #000000 & #5CC5CB
  ═══════════════════════════════════════════════════ */

  .main-cart-section {
    width: 100%;
    min-height: 80vh;
    padding: 120px 48px 100px;
    background-color: #FFFFFF;
    font-family: 'Inter', system-ui, sans-serif;
    color: #000000;
  }

  .cart-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Header */
  .cart-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .cart-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #5CC5CB;
    text-transform: uppercase;
    display: block;
    margin-bottom: 10px;
  }

  .cart-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(38px, 5vw, 56px);
    font-weight: 500;
    color: #000000;
    margin: 0;
  }

  .cart-title em {
    font-style: italic;
    color: #5CC5CB;
    font-weight: 400;
  }

  /* Layout Grid */
  .cart-layout-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
  }

  /* Items Column */
  .cart-items-col {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .cart-table-header {
    display: grid;
    grid-template-columns: 1fr 140px 100px;
    gap: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #EFEAE3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #888888;
    text-transform: uppercase;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
  }

  .cart-item-row {
    display: grid;
    grid-template-columns: 1fr 140px 100px;
    gap: 20px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid #EFEAE3;
  }

  .cart-item-info {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cart-item-img-wrap {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    background: #FFFFFF;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .cart-item-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-item-title {
    font-size: 15px;
    font-weight: 600;
    color: #000000;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cart-item-title:hover {
    color: #5CC5CB;
  }

  .cart-item-variant {
    font-size: 12px;
    color: #777777;
  }

  .cart-item-price-mobile {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: #5CC5CB;
  }

  .cart-item-remove-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: #888888;
    text-decoration: none;
    margin-top: 4px;
    transition: color 0.2s ease;
  }

  .cart-item-remove-btn:hover {
    color: #E31C5F;
  }

  /* Quantity Control */
  .cart-qty-control {
    display: inline-flex;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid #E0D8CE;
    border-radius: 100px;
    padding: 3px 10px;
  }

  .cart-qty-btn {
    color: #000000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 8px;
    transition: color 0.2s ease;
  }

  .cart-qty-btn:hover {
    color: #5CC5CB;
  }

  .cart-qty-input {
    width: 36px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #000000;
    outline: none;
    -moz-appearance: textfield;
  }

  .cart-item-total {
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    text-align: right;
  }

  .cart-col-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 28px;
  }

  .cart-continue-btn {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #000000;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cart-continue-btn:hover {
    color: #5CC5CB;
  }

  .cart-update-btn {
    background: transparent;
    border: 1.5px solid #000000;
    color: #000000;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 10px 24px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .cart-update-btn:hover {
    background: #000000;
    color: #FFFFFF;
  }

  /* Summary Card */
  .cart-summary-card {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-summary-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #5CC5CB;
    text-transform: uppercase;
    margin: 0;
  }

  .cart-summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 500;
    color: #000000;
    border-bottom: 1px solid #EFEAE3;
    padding-bottom: 16px;
  }

  .summary-subtotal-price {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
  }

  .cart-summary-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #777777;
    line-height: 1.4;
  }

  .cart-checkout-btn {
    width: 100%;
    height: 52px;
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  }

  .cart-checkout-btn:hover {
    background: #5CC5CB;
    box-shadow: 0 12px 28px rgba(92, 197, 203, 0.35);
  }

  .cart-secure-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 11px;
    color: #888888;
  }

  /* Empty Cart */
  .cart-empty-box {
    background: #FFFFFF;
    border-radius: 24px;
    padding: 80px 32px;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    box-shadow: 0 4px 24px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cart-empty-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .cart-empty-box h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    color: #000000;
    margin: 0;
  }

  .cart-empty-box p {
    font-size: 14px;
    color: #777777;
    margin: 0 0 16px 0;
    line-height: 1.6;
  }

  .cart-empty-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #000000;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 16px 36px;
    border-radius: 100px;
    transition: all 0.3s ease;
  }

  .cart-empty-shop-btn:hover {
    background: #5CC5CB;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .cart-layout-grid {
      grid-template-columns: 1fr;
    }
    .cart-table-header {
      display: none;
    }
    .cart-item-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .cart-item-total {
      display: none;
    }
    .cart-item-price-mobile {
      display: block;
    }
    .main-cart-section {
      padding: 90px 20px 60px;
    }
  }
</style>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
