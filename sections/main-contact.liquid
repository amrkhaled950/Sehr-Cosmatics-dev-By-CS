{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<section class="main-contact-section" id="main-contact-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="contact-container">

    <!-- ── Page Header Area ── -->
    <div class="contact-header">
      <span class="contact-eyebrow" data-reveal="fade-up" data-delay="0">
        {% if is_arabic %}{{ section.settings.eyebrow_ar | default: 'تواصل معنا' }}{% else %}{{ section.settings.eyebrow_en | default: 'CONTACT US' }}{% endif %}
      </span>
      
      <h1 class="contact-title" data-reveal="fade-up" data-delay="100">
        {% if is_arabic %}{{ section.settings.title_ar | default: 'نود أن نسمع منك' }}{% else %}{{ section.settings.title_en | default: "We'd Love to Hear From You" }}{% endif %}
      </h1>

      <div class="contact-title-line" data-reveal="scale-x" data-delay="200"></div>

      <p class="contact-subtitle" data-reveal="fade-up" data-delay="300">
        {% if is_arabic %}
          لديك سؤال أو اقتراح أو تحتاج إلى دعم؟<br>فريقنا هنا لمساعدتك دائماً.
        {% else %}
          Have a question, suggestion, or need support?<br>Our team is here to help you.
        {% endif %}
      </p>
    </div>

    <!-- ── Main Grid ── -->
    <div class="contact-grid">

      <!-- Left Card: Contact Form -->
      <div class="contact-card contact-form-card" data-reveal="card-3d" data-delay="100">
        <h2 class="contact-card-title">
          {% if is_arabic %}{{ section.settings.form_title_ar | default: 'أرسل لنا رسالة' }}{% else %}{{ section.settings.form_title_en | default: 'Send Us a Message' }}{% endif %}
        </h2>
        <p class="contact-card-sub">
          {% if is_arabic %}املأ النموذج أدناه وسنعاود الاتصال بك في أسرع وقت ممكن.{% else %}Fill out the form below and we'll get back to you as soon as possible.{% endif %}
        </p>

        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-success">
              ✓ {% if is_arabic %}شكراً لتواك معنا! تم إرسال رسالتك بنجاح وسنتواصل معك قريباً.{% else %}Thank you for contacting us! Your message has been sent successfully.{% endif %}
            </div>
          {%- elsif form.errors -%}
            <div class="form-status form-status-error">
              ✕ {% if is_arabic %}حدث خطأ عند إرسال النموذج. يرجى التأكد من صحة البيانات وإعادة المحاولة.{% else %}Please check your inputs and try again.{% endif %}
            </div>
          {%- endif -%}

          <div class="form-row-2col">
            <!-- Name Input -->
            <div class="input-wrap">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input
                type="text"
                name="contact[name]"
                id="ContactFormName"
                placeholder="{% if is_arabic %}اسمك الكامل{% else %}Your Name{% endif %}"
                value="{% if form.name %}{{ form.name }}{% endif %}"
                required
              />
            </div>

            <!-- Email Input -->
            <div class="input-wrap">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input
                type="email"
                name="contact[email]"
                id="ContactFormEmail"
                placeholder="{% if is_arabic %}البريد الإلكتروني{% else %}Email Address{% endif %}"
                value="{% if form.email %}{{ form.email }}{% endif %}"
                required
              />
            </div>
          </div>

          <!-- Phone Input -->
          <div class="input-wrap">
            <span class="input-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <input
              type="tel"
              name="contact[phone]"
              id="ContactFormPhone"
              placeholder="{% if is_arabic %}رقم الهاتف{% else %}Phone Number{% endif %}"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
            />
          </div>

          <!-- Subject Select -->
          <div class="input-wrap select-wrap">
            <span class="input-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.8"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </span>
            <select name="contact[subject]" id="ContactFormSubject">
              <option value="" disabled selected>{% if is_arabic %}اختر الموضوع{% else %}Select Subject{% endif %}</option>
              <option value="General Inquiry">{% if is_arabic %}استفسار عام{% else %}General Inquiry{% endif %}</option>
              <option value="Order Support">{% if is_arabic %}دعم الطلبات والشحن{% else %}Order & Shipping Support{% endif %}</option>
              <option value="Product Advice">{% if is_arabic %}استشارة منتجات{% else %}Product Advice{% endif %}</option>
              <option value="Partnerships">{% if is_arabic %}شراكات وأعمال{% else %}Partnerships & Business{% endif %}</option>
            </select>
          </div>

          <!-- Message Textarea -->
          <div class="input-wrap textarea-wrap">
            <span class="input-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </span>
            <textarea
              name="contact[body]"
              id="ContactFormMessage"
              rows="5"
              placeholder="{% if is_arabic %}اكتب رسالتك هنا...{% else %}Your Message{% endif %}"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="contact-submit-btn">
            <span>{% if is_arabic %}إرسال الرسالة{% else %}SEND MESSAGE{% endif %}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>

          <div class="contact-privacy-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>{% if is_arabic %}نحن نحترم خصوصيتك ومعلوماتك آمنة معنا 100%.{% else %}We respect your privacy and your information is safe with us.{% endif %}</span>
          </div>

        {%- endform -%}
      </div>

      <!-- Right Card: Get in Touch -->
      <div class="contact-card contact-info-card" data-reveal="card-3d" data-delay="250">
        <h2 class="contact-card-title">
          {% if is_arabic %}{{ section.settings.info_title_ar | default: 'تواصل معنا مباشرة' }}{% else %}{{ section.settings.info_title_en | default: 'Get in Touch' }}{% endif %}
        </h2>

        <div class="contact-info-list">
          
          <!-- Phone Item -->
          <div class="info-item" data-reveal="fade-up" data-delay="100">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="info-text">
              <h4>{% if is_arabic %}الهاتف{% else %}Phone{% endif %}</h4>
              <a href="tel:{{ section.settings.phone | default: '+201288247928' }}" class="info-value">
                {{ section.settings.phone | default: '+20 128 824 7928' }}
              </a>
              <span class="info-sub">{% if is_arabic %}يومياً من 9:00 صباحاً - 5:00 مساءً{% else %}Every day, 9:00 AM – 5:00 PM{% endif %}</span>
            </div>
          </div>

          <!-- Email Item -->
          <div class="info-item" data-reveal="fade-up" data-delay="180">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="info-text">
              <h4>{% if is_arabic %}البريد الإلكتروني{% else %}Email{% endif %}</h4>
              <a href="mailto:{{ section.settings.email | default: 'sehrcosmetics@gmail.com' }}" class="info-value">
                {{ section.settings.email | default: 'sehrcosmetics@gmail.com' }}
              </a>
              <span class="info-sub">{% if is_arabic %}عادةً نرد خلال 24 ساعة{% else %}We usually reply within 24 hours{% endif %}</span>
            </div>
          </div>

          <!-- Address Item -->
          <div class="info-item" data-reveal="fade-up" data-delay="260">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="info-text">
              <h4>{% if is_arabic %}العنوان{% else %}Address{% endif %}</h4>
              <span class="info-value">{{ section.settings.address | default: 'Cairo, Egypt' }}</span>
              <span class="info-sub">{% if is_arabic %}المقر الرئيسي{% else %}Our Headquarters{% endif %}</span>
            </div>
          </div>

          <!-- Support Item -->
          <div class="info-item" data-reveal="fade-up" data-delay="340">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="info-text">
              <h4>{% if is_arabic %}خدمة العملاء{% else %}Customer Support{% endif %}</h4>
              <a href="mailto:{{ section.settings.email | default: 'sehrcosmetics@gmail.com' }}" class="info-value">
                {{ section.settings.email | default: 'sehrcosmetics@gmail.com' }}
              </a>
              <span class="info-sub">{% if is_arabic %}للطلبات، الشحن والإرجاع{% else %}For orders, shipping & returns{% endif %}</span>
            </div>
          </div>

        </div>

        <!-- Social Follow -->
        <div class="contact-social-section">
          <h4>{% if is_arabic %}تابعنا على السوشيال ميديا{% else %}Follow Us{% endif %}</h4>
          <div class="contact-social-btns" data-reveal="pop-spin" data-delay="300">
            <a href="https://instagram.com" target="_blank" class="csocial-btn" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://facebook.com" target="_blank" class="csocial-btn" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://tiktok.com" target="_blank" class="csocial-btn" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#5CC5CB"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.53V6.76a4.85 4.85 0 0 1-1.02-.07z"/></svg>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- ── Bottom Guarantees Section ── -->
    <div class="contact-guarantees-card" data-reveal="promise-card" data-delay="100">
      <div class="contact-guarantees-grid">
        
        <div class="guarantee-item">
          <div class="guarantee-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M2 22c1.25-.987 2.27-1.975 3.9-2.2a5.56 5.56 0 0 1 3.8 1.5 4 4 0 0 0 6.187-2.353 3.5 3.5 0 0 0 3.69-5.116A3.5 3.5 0 0 0 20.95 8 3.5 3.5 0 1 0 16 3.05a3.5 3.5 0 0 0-5.831 1.373 3.5 3.5 0 0 0-5.116 3.69 4 4 0 0 0-2.348 6.155C3.499 15.42 3 17.621 2 22z"/></svg>
          </div>
          <div class="guarantee-text">
            <h3>{% if is_arabic %}نهتم بك{% else %}We Care{% endif %}</h3>
            <p>{% if is_arabic %}رضاك يعني كل شيء بالنسبة لنا.{% else %}Your satisfaction means everything to us.{% endif %}</p>
          </div>
        </div>

        <div class="guarantee-item">
          <div class="guarantee-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M10 2v7.31L4.75 18.2A2 2 0 0 0 6.46 21h11.08a2 2 0 0 0 1.71-2.8L14 9.31V2"/><line x1="8.5" y1="2" x2="15.5" y2="2"/></svg>
          </div>
          <div class="guarantee-text">
            <h3>{% if is_arabic %}مدعوم بالعلم{% else %}Science Backed{% endif %}</h3>
            <p>{% if is_arabic %}كل إجابة مدعومة بالمعرفة والعناية.{% else %}Every answer is backed by knowledge and care.{% endif %}</p>
          </div>
        </div>

        <div class="guarantee-item">
          <div class="guarantee-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="guarantee-text">
            <h3>{% if is_arabic %}استجابة سريعة{% else %}Quick Response{% endif %}</h3>
            <p>{% if is_arabic %}نهدف للرد على جميع الاستفسارات خلال 24 ساعة.{% else %}We aim to respond to all inquiries within 24 hours.{% endif %}</p>
          </div>
        </div>

        <div class="guarantee-item">
          <div class="guarantee-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="guarantee-text">
            <h3>{% if is_arabic %}دائماً بجانبك{% else %}Always Here{% endif %}</h3>
            <p>{% if is_arabic %}نحن هنا لدعمك دائماً وفي كل وقت.{% else %}We're here to support you, always.{% endif %}</p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════
     MAIN CONTACT SECTION STYLES — #000000 & #5CC5CB
  ═══════════════════════════════════════════════════ */

  .main-contact-section {
    width: 100%;
    padding: 120px 48px 100px;
    background-color: #FFFFFF;
    font-family: 'Inter', system-ui, sans-serif;
    color: #000000;
  }

  .contact-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Header */
  .contact-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .contact-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #5CC5CB;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .contact-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(44px, 5.5vw, 68px);
    font-weight: 500;
    color: #000000;
    margin: 0 0 18px 0;
    line-height: 1.05;
  }

  .contact-title-line {
    width: 60px;
    height: 1.5px;
    background: #5CC5CB;
    margin: 0 auto 24px;
  }

  .contact-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  /* Grid Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 48px;
  }

  /* Card Base */
  .contact-card {
    background: #FFFFFF;
    border-radius: 24px;
    padding: 44px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.03);
    border: 1px solid #E0D8CE;
  }

  .contact-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    color: #000000;
    margin: 0 0 8px 0;
  }

  .contact-card-sub {
    font-size: 13px;
    color: #666666;
    margin: 0 0 28px 0;
    line-height: 1.5;
  }

  /* Form Elements */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 18px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  [dir="rtl"] .input-icon {
    left: auto;
    right: 18px;
  }

  .input-wrap input,
  .input-wrap select,
  .input-wrap textarea {
    width: 100%;
    background: #FFFFFF;
    border: 1.5px solid #E0D8CE;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    color: #000000;
    padding: 14px 20px 14px 48px;
    outline: none;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  [dir="rtl"] .input-wrap input,
  [dir="rtl"] .input-wrap select,
  [dir="rtl"] .input-wrap textarea {
    padding: 14px 48px 14px 20px;
  }

  .input-wrap textarea {
    border-radius: 20px;
    resize: vertical;
    padding-top: 16px;
  }

  .input-wrap input:focus,
  .input-wrap select:focus,
  .input-wrap textarea:focus {
    border-color: #5CC5CB;
    background: #FFFFFF;
  }

  .input-wrap input::placeholder,
  .input-wrap textarea::placeholder {
    color: #888888;
  }

  .select-wrap select {
    appearance: none;
    cursor: pointer;

  }

  .contact-submit-btn {
    width: 100%;
    height: 52px;
    background: #5CC5CB;
    color: #000000;
    border: none;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(92, 197, 203, 0.25);
    margin-top: 6px;
  }

  .contact-submit-btn:hover {
    background: #000000;
    color: #FFFFFF;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  .contact-privacy-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 11px;
    color: #777777;
    margin-top: 10px;
  }

  /* Info Card Right */
  .contact-info-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 36px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #D2F2F4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-text h4 {
    font-size: 12px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 3px 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info-value {
    font-size: 14px;
    font-weight: 600;
    color: #000000;
    text-decoration: none;
    display: block;
    transition: color 0.2s ease;
  }

  .info-value:hover {
    color: #5CC5CB;
  }

  .info-sub {
    font-size: 11px;
    color: #777777;
    display: block;
    margin-top: 2px;
  }

  /* Social Section */
  .contact-social-section h4 {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #000000;
    text-transform: uppercase;
    margin: 0 0 14px 0;
  }

  .contact-social-btns {
    display: flex;
    gap: 12px;
  }

  .csocial-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #D2F2F4;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .csocial-btn:hover {
    background: #5CC5CB;
    border-color: #5CC5CB;
    transform: translateY(-3px);
  }

  .csocial-btn:hover svg {
    stroke: #FFFFFF;
    fill: #FFFFFF;
  }

  /* Guarantees Bottom Card */
  .contact-guarantees-card {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.03);
    border: 1px solid #E0D8CE;
  }

  .contact-guarantees-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .guarantee-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .guarantee-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .guarantee-text h3 {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 4px 0;
  }

  .guarantee-text p {
    font-size: 12px;
    line-height: 1.5;
    color: #666666;
    margin: 0;
  }

  .form-status {
    padding: 12px 18px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.4;
  }
  .form-status-success {
    background: #E6F8F9;
    color: #0F767E;
    border: 1px solid #B8ECEF;
  }
  .form-status-error {
    background: #FDF2F2;
    color: #9B1C1C;
    border: 1px solid #FBD5D5;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row-2col {
      grid-template-columns: 1fr;
    }
    .contact-guarantees-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .main-contact-section {
      padding: 90px 20px 60px;
    }
    .contact-card {
      padding: 32px 24px;
    }
  }

  /* ── Scroll Animations ── */
  [data-reveal] {
    opacity: 0;
    transition-property: transform, opacity, filter, box-shadow;
    transition-duration: 0.85s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  [data-reveal="fade-up"] {
    transform: translateY(30px);
  }

  [data-reveal="scale-x"] {
    transform: scaleX(0);
    transform-origin: center;
  }

  [data-reveal="card-3d"] {
    transform: perspective(1000px) rotateX(10deg) translateY(30px);
  }

  [data-reveal="pop-spin"] {
    transform: scale(0) rotate(-180deg);
  }

  [data-reveal="promise-card"] {
    transform: translateY(35px) scale(0.97);
  }

  /* Revealed Active States */
  [data-reveal].is-in-view {
    opacity: 1;
    transform: none;
  }

  [data-reveal="scale-x"].is-in-view {
    transform: scaleX(1);
    opacity: 1;
  }

  [data-reveal="pop-spin"].is-in-view {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }

  [data-reveal="promise-card"].is-in-view {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const revealElements = document.querySelectorAll('#main-contact-{{ section.id }} [data-reveal]');
    if (!revealElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const delay = el.getAttribute('data-delay') || 0;
          setTimeout(() => {
            el.classList.add('is-in-view');
          }, parseInt(delay));
          observer.unobserve(el);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  });
</script>

