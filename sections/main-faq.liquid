{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

<section class="main-faq-section" id="main-faq-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="faq-container">

    <!-- ── Page Header Area ── -->
    <div class="faq-header">
      <span class="faq-eyebrow" data-reveal="fade-up" data-delay="0">
        {% if is_arabic %}{{ section.settings.eyebrow_ar | default: 'الأسئلة الشائعة والدعم' }}{% else %}{{ section.settings.eyebrow_en | default: 'HELP & SUPPORT' }}{% endif %}
      </span>
      <h1 class="faq-title" data-reveal="fade-up" data-delay="100">
        {% if is_arabic %}{{ section.settings.title_ar | default: 'الأسئلة الشائعة' }}{% else %}{{ section.settings.title_en | default: 'Frequently Asked Questions' }}{% endif %}
      </h1>
      <div class="faq-title-line" data-reveal="scale-x" data-delay="200"></div>
      <p class="faq-subtitle" data-reveal="fade-up" data-delay="300">
        {% if is_arabic %}
          إجابات شاملة عن كافة استفساراتك حول منتجات سحر، طرق الاستخدام، الأمان، الشحن والدعم.
        {% else %}
          Find answers to common questions about Desura De Sehr products, usage, safety, shipping, and support.
        {% endif %}
      </p>

      <!-- Search Box -->
      <div class="faq-search-wrap" data-reveal="fade-up" data-delay="400">
        <span class="faq-search-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input
          type="text"
          id="FaqSearchInput"
          class="faq-search-input"
          placeholder="{% if is_arabic %}ابحث عن سؤالك هنا...{% else %}Search your question here...{% endif %}"
        />
      </div>
    </div>

    <!-- ── Filter Tabs ── -->
    <div class="faq-tabs" data-reveal="fade-up" data-delay="450">
      <button class="faq-tab-btn active" data-filter="all">
        {% if is_arabic %}جميع الأسئلة{% else %}All Questions{% endif %}
      </button>
      <button class="faq-tab-btn" data-filter="products">
        {% if is_arabic %}المنتجات والاستخدام{% else %}Products & Usage{% endif %}
      </button>
      <button class="faq-tab-btn" data-filter="shipping">
        {% if is_arabic %}الشحن والطلبات{% else %}Shipping & Orders{% endif %}
      </button>
    </div>

    <!-- ── FAQ Accordion Grid ── -->
    <div class="faq-accordion-grid">

      <!-- Question 1 -->
      <div class="faq-item" data-category="products" data-reveal="card-3d" data-delay="0">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}هل منتجات سحر آمنة؟{% else %}Are Sehr products safe?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                نعم، جميع منتجات <strong>سحر</strong> مصنوعة بمكونات مختارة بعناية ومختبرة لضمان أعلى معايير الأمان والفعالية للجسم والشعر والبشرة.
              {% else %}
                Yes. All <strong>Sehr</strong> products are crafted with carefully selected ingredients, thoroughly tested for safety and efficacy for your body, hair, and skin.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="faq-item" data-category="products" data-reveal="card-3d" data-delay="100">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}كم مرة يجب أن أستخدم المنتجات؟{% else %}How often should I use the products?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                يختلف الاستخدام حسب كل منتج:
              {% else %}
                Usage instructions vary by product:
              {% endif %}
            </p>
            <ul class="faq-usage-list">
              <li>
                <strong>{% if is_arabic %}زيت الشعر:{% else %}Hair Oil:{% endif %}</strong>
                {% if is_arabic %}من 2 إلى 3 مرات أسبوعياً.{% else %}2 to 3 times per week.{% endif %}
              </li>
              <li>
                <strong>{% if is_arabic %}سيروم الرموش والحواجب:{% else %}Lash & Brow Serum:{% endif %}</strong>
                {% if is_arabic %}يومياً.{% else %}Daily.{% endif %}
              </li>
              <li>
                <strong>{% if is_arabic %}سيروم الهالات تحت العين:{% else %}Under-Eye Serum:{% endif %}</strong>
                {% if is_arabic %}يومياً.{% else %}Daily.{% endif %}
              </li>
            </ul>
            <p class="faq-note">
              {% if is_arabic %}
                ويُفضل دائماً اتباع التعليمات المحددة المدونة على عبوة كل منتج لضمان أفضل نتائج.
              {% else %}
                We recommend following the specific instructions provided on each product packaging for best results.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="faq-item" data-category="products" data-reveal="card-3d" data-delay="150">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}هل المنتجات مناسبة لكل أنواع البشرة والشعر؟{% else %}Are the products suitable for all skin and hair types?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                معظم تركيباتنا مصممة بعناية لتناسب مدى واسع ومختلف من أنواع البشرة والشعر. يُرجى مراجعة وصف وشروط كل منتج لمعرفة التوافق الدقيق.
              {% else %}
                Most of our formulas are thoughtfully created to suit a wide range of hair and skin types. Please refer to the specific product description for detailed suitability.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 4 -->
      <div class="faq-item" data-category="products" data-reveal="card-3d" data-delay="200">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}هل تحتوي منتجاتكم على مواد قاسية أو ضارة؟{% else %}Do your products contain harsh or harmful ingredients?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                لا. نحن نركز على تقديم تركيبات نظيفة وفعالة خالية تماماً من أي مكونات قاسية أو غير ضرورية للحفاظ على صحة وسلامة بشرتك وشعرك.
              {% else %}
                No. We focus on clean, effective formulas without any harsh or unnecessary ingredients to maintain the health and safety of your skin and hair.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 5 -->
      <div class="faq-item" data-category="products" data-reveal="card-3d" data-delay="250">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}متى تظهر النتائج؟{% else %}When can I expect to see results?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                تختلف المدة حسب طبيعة المنتج وطريقة الاستخدام، ولكن يلاحظ معظم المستخدمين تحسناً ملحوظاً ونتائج إيجابية مع الاستخدام المنتظم خلال بضعة أسابيع.
              {% else %}
                Timelines vary depending on the product and application, but most users notice visible improvements and positive results within a few weeks of regular use.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 6 -->
      <div class="faq-item" data-category="shipping" data-reveal="card-3d" data-delay="300">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}هل يتم الشحن لجميع المحافظات؟{% else %}Do you ship to all governorates?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                نعم، نقوم بالشحن والتوصيل إلى جميع محافظات ومدن جمهورية مصر العربية بأمان وسرعة.
              {% else %}
                Yes, we ship and deliver to all governorates and cities across Egypt safely and quickly.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

      <!-- Question 7 -->
      <div class="faq-item" data-category="shipping" data-reveal="card-3d" data-delay="350">
        <button class="faq-question-btn">
          <span class="faq-q-text">
            {% if is_arabic %}ماذا أفعل إذا وصل الطلب تالفاً؟{% else %}What should I do if my order arrives damaged?{% endif %}
          </span>
          <span class="faq-icon-wrap">
            <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </button>
        <div class="faq-answer-panel">
          <div class="faq-answer-content">
            <p>
              {% if is_arabic %}
                يُرجى التواصل معنا فوراً عبر الهاتف أو البريد الإلكتروني، وسيقوم فريق خدمة العملاء باستبدال المنتج لك في أسرع وقت ممكن.
              {% else %}
                Please contact our customer support team immediately via phone or email, and we will replace the damaged item for you as quickly as possible.
              {% endif %}
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- No Results Placeholder -->
    <div id="FaqNoResults" class="faq-no-results" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
      <p>{% if is_arabic %}لم نجد أي أسئلة تطابق بحثك.{% else %}No questions found matching your search.{% endif %}</p>
    </div>

    <!-- ── Still Have Questions Card ── -->
    <div class="faq-help-card" data-reveal="promise-card" data-delay="100">
      <div class="faq-help-content">
        <div class="faq-help-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="faq-help-text">
          <h2>{% if is_arabic %}هل لديك سؤال آخر؟{% else %}Still Have Questions?{% endif %}</h2>
          <p>{% if is_arabic %}فريق الدعم لدينا جاهز دائماً لمساعدتك والإجابة عن جميع استفساراتك.{% else %}Our support team is always ready to assist you and answer all your questions.{% endif %}</p>
        </div>
        <div class="faq-help-btns">
          <a href="/pages/contact" class="faq-contact-btn">
            {% if is_arabic %}تواصل معنا{% else %}Contact Us{% endif %} →
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .main-faq-section {
    width: 100%;
    padding: 110px 32px 90px;
    background-color: #FFFFFF;
    font-family: 'Inter', system-ui, sans-serif;
    color: #000000;
    overflow: hidden;
  }

  .faq-container {
    max-width: 920px;
    margin: 0 auto;
  }

  /* Header */
  .faq-header {
    text-align: center;
    margin-bottom: 52px;
  }

  .faq-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #5CC5CB;
    text-transform: uppercase;
    display: block;
    margin-bottom: 10px;
  }

  .faq-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 500;
    color: #000000;
    margin: 0 0 12px 0;
    line-height: 1.06;
  }

  .faq-title-line {
    width: 60px;
    height: 1.5px;
    background: #5CC5CB;
    margin: 0 auto 20px;
  }

  .faq-subtitle {
    font-size: 15px;
    line-height: 1.65;
    color: #666666;
    max-width: 640px;
    margin: 0 auto 32px;
  }

  /* Search Wrap */
  .faq-search-wrap {
    position: relative;
    max-width: 540px;
    margin: 0 auto;
  }

  .faq-search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  [dir="rtl"] .faq-search-icon {
    left: auto;
    right: 20px;
  }

  .faq-search-input {
    width: 100%;
    height: 52px;
    padding: 0 20px 0 52px;
    border: 1px solid #D9EFEF;
    border-radius: 30px;
    background: #F8FCFC;
    font-size: 14px;
    color: #000000;
    outline: none;
    transition: all 0.3s ease;
  }

  [dir="rtl"] .faq-search-input {
    padding: 0 52px 0 20px;
  }

  .faq-search-input:focus {
    border-color: #5CC5CB;
    background: #FFFFFF;
    box-shadow: 0 8px 24px rgba(92, 197, 203, 0.15);
  }

  /* Filter Tabs */
  .faq-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .faq-tab-btn {
    padding: 10px 22px;
    border-radius: 25px;
    border: 1px solid #D9EFEF;
    background: #FFFFFF;
    color: #555555;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .faq-tab-btn:hover {
    border-color: #5CC5CB;
    color: #5CC5CB;
  }

  .faq-tab-btn.active {
    background: #5CC5CB;
    border-color: #5CC5CB;
    color: #FFFFFF;
    box-shadow: 0 4px 16px rgba(92, 197, 203, 0.3);
  }

  /* Accordion Grid */
  .faq-accordion-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 60px;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid #E6F6F7;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(92, 197, 203, 0.04);
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: #5CC5CB;
    box-shadow: 0 8px 30px rgba(92, 197, 203, 0.12);
  }

  .faq-question-btn {
    width: 100%;
    padding: 22px 28px;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    text-align: left;
    cursor: pointer;
    outline: none;
  }

  [dir="rtl"] .faq-question-btn {
    text-align: right;
  }

  .faq-q-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    color: #000000;
    line-height: 1.3;
  }

  .faq-icon-wrap {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F2FAFA;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5CC5CB;
    flex-shrink: 0;
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
  }

  .faq-item.open .faq-icon-wrap {
    transform: rotate(45deg);
    background: #5CC5CB;
    color: #FFFFFF;
  }

  .faq-answer-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-answer-content {
    padding: 0 28px 24px;
    font-size: 14px;
    line-height: 1.75;
    color: #555555;
    border-top: 1px solid #F0FAF9;
    padding-top: 16px;
  }

  .faq-answer-content p {
    margin: 0 0 10px 0;
  }

  .faq-answer-content p:last-child {
    margin: 0;
  }

  .faq-usage-list {
    margin: 10px 0 14px 0;
    padding-left: 20px;
    list-style-type: disc;
  }

  [dir="rtl"] .faq-usage-list {
    padding-left: 0;
    padding-right: 20px;
  }

  .faq-usage-list li {
    margin-bottom: 6px;
  }

  .faq-note {
    font-style: italic;
    color: #777777;
    font-size: 13px;
  }

  /* No Results Placeholder */
  .faq-no-results {
    text-align: center;
    padding: 48px 20px;
    color: #777777;
  }

  .faq-no-results p {
    margin-top: 12px;
    font-size: 15px;
  }

  /* Still Have Questions Card */
  .faq-help-card {
    background: #F4FCFC;
    border: 1px solid #D2F2F4;
    border-radius: 24px;
    padding: 36px 40px;
    box-shadow: 0 8px 30px rgba(92, 197, 203, 0.08);
  }

  .faq-help-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .faq-help-icon {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(92, 197, 203, 0.12);
  }

  .faq-help-text h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 28px;
    font-weight: 500;
    color: #000000;
    margin: 0 0 4px 0;
  }

  .faq-help-text p {
    font-size: 14px;
    color: #666666;
    margin: 0;
  }

  .faq-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 30px;
    background: #000000;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .faq-contact-btn:hover {
    background: #5CC5CB;
    box-shadow: 0 6px 20px rgba(92, 197, 203, 0.35);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .faq-help-content {
      flex-direction: column;
      text-align: center;
    }
    .main-faq-section {
      padding: 80px 16px 60px;
    }
    .faq-question-btn {
      padding: 18px 20px;
    }
    .faq-q-text {
      font-size: 19px;
    }
    .faq-answer-content {
      padding: 0 20px 20px;
    }
  }

  /* ── Scroll Animations ── */
  [data-reveal] {
    opacity: 0;
    transition-property: transform, opacity, filter, box-shadow;
    transition-duration: 0.85s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  [data-reveal="fade-up"] {
    transform: translateY(30px);
  }

  [data-reveal="scale-x"] {
    transform: scaleX(0);
    transform-origin: center;
  }

  [data-reveal="card-3d"] {
    transform: perspective(1000px) rotateX(10deg) translateY(30px);
  }

  [data-reveal="promise-card"] {
    transform: translateY(35px) scale(0.97);
  }

  /* Revealed Active States */
  [data-reveal].is-in-view {
    opacity: 1;
    transform: none;
  }

  [data-reveal="scale-x"].is-in-view {
    transform: scaleX(1);
    opacity: 1;
  }

  [data-reveal="promise-card"].is-in-view {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqContainer = document.getElementById('main-faq-{{ section.id }}');
    if (!faqContainer) return;

    // Accordion Toggle
    const faqItems = faqContainer.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-question-btn');
      const panel = item.querySelector('.faq-answer-panel');

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');

        // Close other open items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('open');
            otherItem.querySelector('.faq-answer-panel').style.maxHeight = null;
          }
        });

        // Toggle current item
        if (isOpen) {
          item.classList.remove('open');
          panel.style.maxHeight = null;
        } else {
          item.classList.add('open');
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
      });
    });

    // Category Tabs Filter
    const tabBtns = faqContainer.querySelectorAll('.faq-tab-btn');
    const searchInput = document.getElementById('FaqSearchInput');
    const noResults = document.getElementById('FaqNoResults');

    function filterFaqs() {
      const activeTab = faqContainer.querySelector('.faq-tab-btn.active').getAttribute('data-filter');
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      faqItems.forEach(item => {
        const category = item.getAttribute('data-category');
        const questionText = item.querySelector('.faq-q-text').textContent.toLowerCase();
        const answerText = item.querySelector('.faq-answer-panel').textContent.toLowerCase();

        const matchesTab = (activeTab === 'all' || category === activeTab);
        const matchesQuery = (!query || questionText.includes(query) || answerText.includes(query));

        if (matchesTab && matchesQuery) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterFaqs();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', filterFaqs);
    }

    // Scroll Reveal Observer
    const revealElements = faqContainer.querySelectorAll('[data-reveal]');
    if (revealElements.length) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = el.getAttribute('data-delay') || 0;
            setTimeout(() => {
              el.classList.add('is-in-view');
            }, parseInt(delay));
            observer.unobserve(el);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      revealElements.forEach(el => observer.observe(el));
    }
  });
</script>

