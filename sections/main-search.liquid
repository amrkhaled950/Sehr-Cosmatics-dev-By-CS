      "label": "Eyebrow (English)",
      "default": "SEARCH OUR RITUALS"
    },
    {
      "type": "text",
      "id": "eyebrow_ar",
      "label": "Eyebrow (Arabic)",
      "default": "نتائج البحث"
    }
  ]
}
{% endschema %}
