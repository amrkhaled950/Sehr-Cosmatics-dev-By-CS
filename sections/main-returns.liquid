  /* Responsive */
  @media (max-width: 1100px) {
    .returns-top-grid,
    .policy-cards-4col {
      grid-template-columns: repeat(2, 1fr);
    }
    .refund-policy-grid {
      grid-template-columns: 1fr;
    }
    .steps-process-grid {
      flex-direction: column;
      gap: 28px;
    }
    .step-arrow {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 768px) {
    .need-help-grid {
      flex-direction: column;
      align-items: flex-start;
    }
    .need-help-contacts {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .main-returns-section {
      padding: 80px 20px 60px;
    }
  }

  @media (max-width: 540px) {
    .returns-top-grid,
    .policy-cards-4col {
      grid-template-columns: 1fr;
    }
  }

  /* ── Scroll Animations ── */
  [data-reveal] {
    opacity: 0;
    transition-property: transform, opacity, filter, box-shadow;
    transition-duration: 0.85s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  [data-reveal="fade-up"] {
    transform: translateY(30px);
  }

  [data-reveal="scale-x"] {
    transform: scaleX(0);
    transform-origin: center;
  }

  [data-reveal="card-3d"] {
    transform: perspective(1000px) rotateX(10deg) translateY(30px);
  }

  [data-reveal="promise-card"] {
    transform: translateY(35px) scale(0.97);
  }

  /* Revealed Active States */
  [data-reveal].is-in-view {
    opacity: 1;
    transform: none;
  }

  [data-reveal="scale-x"].is-in-view {
    transform: scaleX(1);
    opacity: 1;
  }

  [data-reveal="promise-card"].is-in-view {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const revealElements = document.querySelectorAll('#main-returns-{{ section.id }} [data-reveal]');
    if (!revealElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const delay = el.getAttribute('data-delay') || 0;
          setTimeout(() => {
            el.classList.add('is-in-view');
          }, parseInt(delay));
          observer.unobserve(el);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  });
</script>

