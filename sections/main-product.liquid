{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

<!-- ── Model Viewer Script for .glb 3D Files ── -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>

<div class="product-page-wrapper" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}">

  <!-- ── Top Marquee / Ticker Bar ── -->
  <div class="pdp-ticker-bar">
    <div class="pdp-ticker-track">
      <div class="pdp-ticker-content">
        <span>100% NATURAL INGREDIENTS</span> <span class="pdp-star">✦</span>
        <span>DERMATOLOGICALLY TESTED</span> <span class="pdp-star">✦</span>
        <span>MADE WITH LOVE IN EGYPT</span> <span class="pdp-star">✦</span>
        <span>SECURE PAYMENT</span> <span class="pdp-star">✦</span>
        <span>EASY RETURNS</span> <span class="pdp-star">✦</span>
        <span>FREE DELIVERY</span> <span class="pdp-star">✦</span>
      </div>
      <div class="pdp-ticker-content" aria-hidden="true">
        <span>100% NATURAL INGREDIENTS</span> <span class="pdp-star">✦</span>
        <span>DERMATOLOGICALLY TESTED</span> <span class="pdp-star">✦</span>
        <span>MADE WITH LOVE IN EGYPT</span> <span class="pdp-star">✦</span>
        <span>SECURE PAYMENT</span> <span class="pdp-star">✦</span>
        <span>EASY RETURNS</span> <span class="pdp-star">✦</span>
        <span>FREE DELIVERY</span> <span class="pdp-star">✦</span>
      </div>
    </div>
  </div>

  <div class="pdp-main-container">
    
    <!-- ── Breadcrumbs ── -->
    <nav class="pdp-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">{% if is_arabic %}الرئيسية{% else %}HOME{% endif %}</a>
      <span class="sep">/</span>
      <a href="/collections/all">{% if is_arabic %}المتجر{% else %}SHOP{% endif %}</a>
      <span class="sep">/</span>
      <span class="current">{{ product.title | default: 'sehr hair oil' }}</span>
    </nav>

    <!-- ── Main Product Grid ── -->
    <div class="pdp-grid">

      <!-- Left Column: Media Gallery & 3D Model Viewer -->
      <div class="pdp-gallery-col">
        <div class="pdp-gallery-layout">
          
          <!-- Thumbnails Column -->
          <div class="pdp-thumbnails">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                {%- if media.media_type == 'model' -%}
                  {%- assign media_model_source = media.sources | where: 'format', 'glb' | first -%}
                  {%- if media_model_source == blank -%}
                    {%- assign media_model_source = media.sources | first -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="pdp-thumb-item pdp-thumb-3d-btn {% if forloop.first %}active{% endif %}"
                    data-is-3d="true"
                    data-glb-url="{{ media_model_source.url }}"
                    data-media-id="{{ media.id }}"
                    aria-label="360 View {{ forloop.index }}"
                  >
                    {%- if media.preview_image != blank -%}
                      <img src="{{ media.preview_image | img_url: '200x200', crop: 'center' }}" alt="3D Model {{ forloop.index }}" />
                      <span class="thumb-3d-badge">360°</span>
                    {%- else -%}
                      <div class="thumb-3d-icon-wrap">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="2"><path d="M21.5 12H2.5M12 2.5v19M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/></svg>
                        <span>360°</span>
                      </div>
                    {%- endif -%}
                  </button>
                {%- else -%}
                  <button
                    type="button"
                    class="pdp-thumb-item {% if forloop.first %}active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-full-src="{{ media | img_url: '1400x1400' }}"
                  >
                    <img
                      src="{{ media | img_url: '200x200', crop: 'center' }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="lazy"
                    />
                  </button>
                {%- endif -%}
              {%- endfor -%}

              <!-- Integrated 360° / 3D Thumbnail item if GLB model setting exists and product has no media models -->
              {%- assign media_models_count = product.media | where: 'media_type', 'model' | size -%}
              {%- if section.settings.custom_glb_url != blank and media_models_count == 0 -%}
                <button
                  type="button"
                  class="pdp-thumb-item pdp-thumb-3d-btn"
                  data-is-3d="true"
                  data-glb-url="{{ section.settings.custom_glb_url }}"
                  aria-label="360 View"
                >
                  <div class="thumb-3d-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="2"><path d="M21.5 12H2.5M12 2.5v19M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/></svg>
                    <span>360°</span>
                  </div>
                </button>
              {%- endif -%}

            {%- else -%}
              <!-- Fallback Thumbnails for design preview -->
              <button
                type="button"
                class="pdp-thumb-item active"
                data-full-src="{{ 'hero-bg.jpg' | asset_url }}"
              >
                <img src="{{ 'hero-bg.jpg' | asset_url }}" alt="Thumbnail 1" />
              </button>
              <button
                type="button"
                class="pdp-thumb-item"
                data-full-src="{{ 'hero-bg-ar.jpg' | asset_url }}"
              >
                <img src="{{ 'hero-bg-ar.jpg' | asset_url }}" alt="Thumbnail 2" />
              </button>
              <!-- 360° Integrated Thumbnail -->
              {%- if section.settings.custom_glb_url != blank -%}
                <button
                  type="button"
                  class="pdp-thumb-item pdp-thumb-3d-btn"
                  data-is-3d="true"
                  data-glb-url="{{ section.settings.custom_glb_url }}"
                  aria-label="360 View"
                >
                  <div class="thumb-3d-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="2"><path d="M21.5 12H2.5M12 2.5v19M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/></svg>
                    <span>360°</span>
                  </div>
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>

          <!-- Main Stage Viewport -->
          <div class="pdp-main-stage-wrap">
            
            <!-- Badge -->
            {%- if section.settings.show_badge -%}
              <div class="pdp-badge">
                {{ section.settings.badge_text | default: 'BEST SELLER' }}
              </div>
            {%- endif -%}

            <!-- Expand / Lightbox Button -->
            <button type="button" class="pdp-expand-btn" aria-label="Expand image" id="pdpExpandBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>

            <!-- Image View Stage -->
            <div class="pdp-stage-view" id="pdpImageView">
              {%- if product.featured_image != blank -%}
                <img
                  id="pdpMainImage"
                  src="{{ product.featured_image | img_url: '1400x1400' }}"
                  alt="{{ product.title | escape }}"
                  class="pdp-main-img"
                />
              {%- else -%}
                <img
                  id="pdpMainImage"
                  src="{{ 'hero-bg.jpg' | asset_url }}"
                  alt="Product Image"
                  class="pdp-main-img"
                />
              {%- endif -%}
            </div>

            <!-- 3D Model Stage View (.glb player) -->
            <div class="pdp-3d-stage" id="pdp3dView" style="display: none;">
              {%- assign glb_url = section.settings.custom_glb_url -%}
              {%- assign shopify_3d_model = product.media | where: 'media_type', 'model' | first -%}
              {%- assign initial_glb = '' -%}
              
              {%- if shopify_3d_model != blank -%}
                {%- assign model_source = shopify_3d_model.sources | where: 'format', 'glb' | first -%}
                {%- if model_source == blank -%}
                  {%- assign model_source = shopify_3d_model.sources | first -%}
                {%- endif -%}
                {%- assign initial_glb = model_source.url -%}
              {%- elsif glb_url != blank -%}
                {%- assign initial_glb = glb_url -%}
              {%- else -%}
                {%- assign initial_glb = 'https://modelviewer.dev/shared-assets/models/Astronaut.glb' -%}
              {%- endif -%}

              <model-viewer
                id="pdpModelViewer"
                src="{{ initial_glb }}"
                alt="3D Model of {{ product.title | escape }}"
                auto-rotate
                camera-controls
                ar
                shadow-intensity="1.2"
                environment-image="neutral"
                exposure="1"
                style="width: 100%; height: 100%; min-height: 480px; background-color: transparent;"
              >
                <button slot="ar-button" class="glb-ar-btn">
                  👋 View in your space (AR)
                </button>
              </model-viewer>
            </div>

          </div>

        </div>
      </div>

      <!-- Right Column: Product Details & Purchase Form -->
      <div class="pdp-details-col">
        
        <!-- Category Eyebrow -->
        <span class="pdp-eyebrow">
          {%- if is_arabic -%}
            {{ section.settings.category_eyebrow_ar | default: section.settings.category_eyebrow | default: 'عناية سحر' }}
          {%- else -%}
            {{ section.settings.category_eyebrow | default: 'SEHR CARE' }}
          {%- endif -%}
        </span>

        <!-- Product Main Title -->
        <h1 class="pdp-title">
          {%- if product.title != blank -%}
            {{ product.title }}
          {%- else -%}
            sehr <em>hair</em> oil
          {%- endif -%}
        </h1>

        <!-- Subtitle / Tagline -->
        <p class="pdp-subtitle">
          {%- if is_arabic -%}
            {{ section.settings.subtitle_ar | default: section.settings.subtitle | default: 'جمال يتألق' }}
          {%- else -%}
            {{ section.settings.subtitle | default: 'Beauty Elevated' }}
          {%- endif -%}
        </p>

        <!-- Rating Stars -->
        <div class="pdp-rating">
          <div class="pdp-stars">
            ★ ★ ★ ★ ★
          </div>
          <span class="pdp-review-count">(No reviews yet)</span>
        </div>

        <!-- Price Display -->
        <div class="pdp-price-wrap">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="pdp-price-current">
            {%- if product.price != blank -%}
              {{ product.price | money }}
            {%- else -%}
              LE 300.00
            {%- endif -%}
          </span>
        </div>

        <!-- 4 Key Feature Icons Grid -->
        <div class="pdp-features-grid">
          <div class="pdp-feature-item">
            <div class="pdp-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="pdp-feature-text">
              <strong>{% if is_arabic %}{{ section.settings.feature1_title_ar | default: section.settings.feature1_title | default: 'جودة فاخرة' }}{% else %}{{ section.settings.feature1_title | default: 'Premium' }}{% endif %}</strong>
              <span>{% if is_arabic %}{{ section.settings.feature1_sub_ar | default: section.settings.feature1_sub | default: 'أعلى المعايير' }}{% else %}{{ section.settings.feature1_sub | default: 'Quality' }}{% endif %}</span>
            </div>
          </div>

          <div class="pdp-feature-item">
            <div class="pdp-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </div>
            <div class="pdp-feature-text">
              <strong>{% if is_arabic %}{{ section.settings.feature2_title_ar | default: section.settings.feature2_title | default: 'تغذية عميقة' }}{% else %}{{ section.settings.feature2_title | default: 'Nourishes' }}{% endif %}</strong>
              <span>{% if is_arabic %}{{ section.settings.feature2_sub_ar | default: section.settings.feature2_sub | default: 'للشعر والبشرة' }}{% else %}{{ section.settings.feature2_sub | default: 'Deeply' }}{% endif %}</span>
            </div>
          </div>

          <div class="pdp-feature-item">
            <div class="pdp-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <div class="pdp-feature-text">
              <strong>{% if is_arabic %}{{ section.settings.feature3_title_ar | default: section.settings.feature3_title | default: 'ترطيب كلي' }}{% else %}{{ section.settings.feature3_title | default: 'Hydrates' }}{% endif %}</strong>
              <span>{% if is_arabic %}{{ section.settings.feature3_sub_ar | default: section.settings.feature3_sub | default: 'حماية فائقة' }}{% else %}{{ section.settings.feature3_sub | default: 'Skin' }}{% endif %}</span>
            </div>
          </div>

          <div class="pdp-feature-item">
            <div class="pdp-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.5"><path d="M2 22c1.25-.987 2.27-1.975 3.9-2.2a5.56 5.56 0 0 1 3.8 1.5 4 4 0 0 0 6.187-2.353 3.5 3.5 0 0 0 3.69-5.116A3.5 3.5 0 0 0 20.95 8 3.5 3.5 0 1 0 16 3.05a3.5 3.5 0 0 0-5.831 1.373 3.5 3.5 0 0 0-5.116 3.69 4 4 0 0 0-2.348 6.155C3.499 15.42 3 17.621 2 22z"/></svg>
            </div>
            <div class="pdp-feature-text">
              <strong>{% if is_arabic %}{{ section.settings.feature4_title_ar | default: section.settings.feature4_title | default: '100%' }}{% else %}{{ section.settings.feature4_title | default: '100%' }}{% endif %}</strong>
              <span>{% if is_arabic %}{{ section.settings.feature4_sub_ar | default: section.settings.feature4_sub | default: 'مكونات طبيعية' }}{% else %}{{ section.settings.feature4_sub | default: 'Natural' }}{% endif %}</span>
            </div>
          </div>
        </div>

        <!-- Purchase Form -->
        {%- form 'product', product, id: 'AddToCartForm', class: 'pdp-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="pdpVariantId" />

          <!-- Variant Selector (SIZE Pills) -->
          {%- if product.options_with_values.size > 0 -%}
            {%- for option in product.options_with_values -%}
              <div class="pdp-option-group">
                <label class="pdp-option-label">{{ option.name | uppercase }}</label>
                <div class="pdp-option-pills">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="pdp-pill {% if option.selected_value == value or forloop.first %}active{% endif %}"
                      data-option-position="{{ option.position }}"
                      data-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Size Pills for Demo -->
            <div class="pdp-option-group">
              <label class="pdp-option-label">SIZE</label>
              <div class="pdp-option-pills">
                <button type="button" class="pdp-pill active">30 ML</button>
                <button type="button" class="pdp-pill">60 ML</button>
                <button type="button" class="pdp-pill">100 ML</button>
              </div>
            </div>
          {%- endif -%}

          <!-- Quantity Selector -->
          <div class="pdp-quantity-wrap">
            <label class="pdp-option-label">QUANTITY</label>
            <div class="pdp-qty-control">
              <button type="button" class="pdp-qty-btn" id="qtyMinus" aria-label="Decrease quantity">—</button>
              <input type="number" name="quantity" id="Quantity" value="1" min="1" class="pdp-qty-input" />
              <button type="button" class="pdp-qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <!-- Buttons Group (ADD TO CART + Wishlist Heart) -->
          <div class="pdp-actions-row">
            <button type="submit" name="add" id="AddToCart" class="pdp-atc-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              <span>{% if is_arabic %}أضف إلى السلة{% else %}ADD TO CART{% endif %}</span>
            </button>

            <button type="button" class="pdp-wishlist-heart-btn" aria-label="Add to wishlist" id="pdpWishlistBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
          </div>

          <!-- Small Inline Trust Icons Bar -->
          <div class="pdp-trust-inline-bar">
            <div class="trust-inline-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>{% if is_arabic %}دفع آمن{% else %}Secure Payment{% endif %}</span>
            </div>
            <div class="trust-inline-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span>{% if is_arabic %}شحن سريع{% else %}Fast Delivery{% endif %}</span>
            </div>
            <div class="trust-inline-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{% if is_arabic %}منتج أصلي 100%{% else %}100% Original{% endif %}</span>
            </div>
            <div class="trust-inline-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5CC5CB" stroke-width="1.8"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.87"/></svg>
              <span>{% if is_arabic %}إرجاع سهل{% else %}Easy Returns{% endif %}</span>
            </div>
          </div>

        {%- endform -%}

        <!-- Product Accordions (المكونات | كيفية الاستخدام | معلومات | تحذيرات) -->
        <div class="pdp-accordions">
          
          <!-- 1. المكونات / Ingredients -->
          <details class="pdp-accordion-item" open>
            <summary class="pdp-accordion-header">
              <span>{% if is_arabic %}{{ section.settings.ing_tab_title_ar | default: 'المكونات' }}{% else %}{{ section.settings.ing_tab_title | default: 'INGREDIENTS' }}{% endif %}</span>
              <span class="pdp-accordion-icon">+</span>
            </summary>
            <div class="pdp-accordion-content">
              <p>
                {%- if is_arabic -%}
                  {{ section.settings.ing_tab_content_ar | default: 'زيت الأرغان الطبيعي، زيت الجوجوبا النقية، زيت الروزماري، فيتامين هـ المغذي، ومستخلصات نباتية طبيعية 100%.' }}
                {%- else -%}
                  {{ section.settings.ing_tab_content | default: 'Argania Spinosa (Argan) Kernel Oil, Simmondsia Chinensis (Jojoba) Seed Oil, Rosmarinus Officinalis (Rosemary) Leaf Oil, Tocopherol (Vitamin E).' }}
                {%- endif -%}
              </p>
            </div>
          </details>

          <!-- 2. كيفية الاستخدام / How to Use -->
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-header">
              <span>{% if is_arabic %}{{ section.settings.how_tab_title_ar | default: 'كيفية الاستخدام' }}{% else %}{{ section.settings.how_tab_title | default: 'HOW TO USE' }}{% endif %}</span>
              <span class="pdp-accordion-icon">+</span>
            </summary>
            <div class="pdp-accordion-content">
              <p>
                {%- if is_arabic -%}
                  {{ section.settings.how_tab_content_ar | default: 'ضعي من 3 إلى 5 قطرات في راحة اليد، ويدلك بفرك اليدين معاً، ويوزع برفق على المنطقة المستهدفة حتى يتم الامتصاص بالكامل.' }}
                {%- else -%}
                  {{ section.settings.how_tab_content | default: 'Apply 3-5 drops into palm, rub hands together, and gently massage into target area until fully absorbed.' }}
                {%- endif -%}
              </p>
            </div>
          </details>

          <!-- 3. معلومات / Information -->
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-header">
              <span>{% if is_arabic %}{{ section.settings.info_tab_title_ar | default: 'معلومات' }}{% else %}{{ section.settings.info_tab_title | default: 'INFORMATION' }}{% endif %}</span>
