<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* ── Thumbnail Click Switcher & 3D Stage Toggle ── */
    const thumbs = document.querySelectorAll('.pdp-thumb-item');
    const mainImg = document.getElementById('pdpMainImage');
    const photoView = document.getElementById('pdpImageView');
    const modelView = document.getElementById('pdp3dView');
    const modelViewer = document.getElementById('pdpModelViewer');

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', function () {
        thumbs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        const is3D = this.getAttribute('data-is-3d') === 'true';

        if (is3D) {
          if (photoView) photoView.style.display = 'none';
          if (modelView) modelView.style.display = 'flex';

          const glbUrl = this.getAttribute('data-glb-url');
          if (modelViewer && glbUrl) {
            const currentSrc = modelViewer.getAttribute('src');
            if (currentSrc !== glbUrl) {
              modelViewer.setAttribute('src', glbUrl);
            }
          }
        } else {
          if (modelView) modelView.style.display = 'none';
          if (photoView) photoView.style.display = 'flex';

          const fullSrc = this.getAttribute('data-full-src') || (this.querySelector('img') ? this.querySelector('img').src : '');
          if (mainImg && fullSrc) {
            mainImg.style.opacity = '0.3';
            mainImg.src = fullSrc;
            setTimeout(() => {
              mainImg.style.opacity = '1';
            }, 80);
          }
        }
      });
    });

    /* ── Expand Lightbox Image Modal ── */
    const expandBtn = document.getElementById('pdpExpandBtn');
    const lightboxModal = document.getElementById('pdpLightboxModal');
    const lightboxImg = document.getElementById('pdpLightboxImg');
    const lightboxClose = document.getElementById('pdpLightboxClose');
    const lightboxBackdrop = document.getElementById('pdpLightboxBackdrop');

    if (expandBtn && lightboxModal && lightboxImg) {
      expandBtn.addEventListener('click', function () {
        if (mainImg && mainImg.src) {
          lightboxImg.src = mainImg.src;
          lightboxModal.style.display = 'flex';
        }
      });

      if (lightboxClose) {
        lightboxClose.addEventListener('click', function () {
          lightboxModal.style.display = 'none';
        });
      }
      if (lightboxBackdrop) {
        lightboxBackdrop.addEventListener('click', function () {
          lightboxModal.style.display = 'none';
        });
      }
    }

    /* ── Quantity Controls ── */
    const qtyInput = document.getElementById('Quantity');
    const btnPlus = document.getElementById('qtyPlus');
    const btnMinus = document.getElementById('qtyMinus');

    if (qtyInput && btnPlus && btnMinus) {
      btnPlus.addEventListener('click', function () {
        qtyInput.value = parseInt(qtyInput.value || 1) + 1;
      });
      btnMinus.addEventListener('click', function () {
        const val = parseInt(qtyInput.value || 1);
        if (val > 1) qtyInput.value = val - 1;
      });
    }

    /* ── Variant Pill Selection ── */
    const pills = document.querySelectorAll('.pdp-pill');
    pills.forEach(pill => {
      pill.addEventListener('click', function () {
        const parent = this.closest('.pdp-option-pills');
        if (parent) {
          parent.querySelectorAll('.pdp-pill').forEach(p => p.classList.remove('active'));
          this.classList.add('active');
        }
      });
    });

    /* ── Wishlist Heart Toggle & LocalStorage Sync ── */
    const wishlistBtn = document.getElementById('pdpWishlistBtn');
    if (wishlistBtn) {
      const productTitle = {{ product.title | default: 'sehr hair oil' | json }};
      const productPrice = {{ product.price | money | default: 'LE 300.00' | json }};
      const productImage = {{ product.featured_image | img_url: '400x400' | json }};
      const productUrl = {{ product.url | default: '#' | json }};
      const variantId = {{ current_variant.id | json }};

      function isSaved() {
        try {
          const list = JSON.parse(localStorage.getItem('desura_wishlist') || '[]');
          return list.some(item => item.title === productTitle);
        } catch (e) {
          return false;
        }
      }

      if (isSaved()) {
        wishlistBtn.classList.add('active');
      }

      wishlistBtn.addEventListener('click', function () {
        try {
          let list = JSON.parse(localStorage.getItem('desura_wishlist') || '[]');
          if (isSaved()) {
            list = list.filter(item => item.title !== productTitle);
            this.classList.remove('active');
          } else {
            list.push({ title: productTitle, price: productPrice, image: productImage, url: productUrl, variantId: variantId });
            this.classList.add('active');
          }
          localStorage.setItem('desura_wishlist', JSON.stringify(list));
        } catch (e) {
          this.classList.toggle('active');
        }
      });
    }
  });
</script>

