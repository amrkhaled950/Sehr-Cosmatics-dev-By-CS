  ═══════════════════════════════════════════════════ */

  .product-page-wrapper {
    width: 100%;
    background-color: #FFFFFF;
    min-height: 100vh;
    padding-top: 100px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #000000;
  }

  /* ── Top Marquee Ticker ── */
  .pdp-ticker-bar {
    width: 100%;
    background: #F4ECE4;
    border-top: 1px solid #EBE2D8;
    border-bottom: 1px solid #EBE2D8;
    overflow: hidden;
    padding: 10px 0;
    white-space: nowrap;
  }

  .pdp-ticker-track {
    display: flex;
    width: max-content;
    animation: pdpTicker 35s linear infinite;
  }

  .pdp-ticker-content {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: #000000;
    text-transform: uppercase;
  }

  .pdp-star {
    color: #5CC5CB;
    font-size: 12px;
  }

  @keyframes pdpTicker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── Main Container ── */
  .pdp-main-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 40px 48px 100px;
  }

  /* ── Breadcrumbs ── */
  .pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #888888;
    text-transform: uppercase;
    margin-bottom: 36px;
  }

  .pdp-breadcrumbs a {
    color: #888888;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pdp-breadcrumbs a:hover {
    color: #000000;
  }

  .pdp-breadcrumbs .sep {
    color: #CCCCCC;
  }

  .pdp-breadcrumbs .current {
    color: #000000;
  }

  /* ── Grid Layout ── */
  .pdp-grid {
