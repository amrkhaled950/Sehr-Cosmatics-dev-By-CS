{%- assign is_arabic = false -%}
{%- if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' or request.path contains '/ar' or content_for_header contains 'lang=ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{% if is_arabic %}rtl{% else %}{{ settings.text_direction | default: 'ltr' }}{% endif %}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    {%- if template == 'index' -%}
      {{ shop.name }} — {{ page_title }}
    {%- elsif page_title -%}
      {{ page_title }} — {{ shop.name }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}" />
  {%- endif -%}

  <!-- Favicon -->
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}" />
  {%- endif -%}

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}" />

  <!-- Shopify -->
  {{ content_for_header }}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Theme CSS -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'hero-desura-sehr.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-{{ template | replace: '.', '-' }}">

  <!-- ── Floating Glass Header Wrapper (Overlays Hero Image Directly) ── -->
  <header class="header-overlay-wrapper">
    {%- section 'announcement-bar' -%}
    {%- section 'header' -%}
  </header>

  <!-- ── Main Content ── -->
  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  <!-- ── Footer ── -->
  {%- section 'footer' -%}

  <!-- ── Global Scroll Reveal Script ── -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      function initGlobalScrollReveal() {
        const scrollEls = document.querySelectorAll('[data-scroll]:not(.is-in-view)');
        if (!scrollEls.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = parseInt(el.getAttribute('data-scroll-delay') || 0, 10);
              setTimeout(() => {
                el.classList.add('is-in-view');
              }, delay);
              observer.unobserve(el);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -30px 0px'
        });

        scrollEls.forEach(el => observer.observe(el));
      }

      initGlobalScrollReveal();
      document.addEventListener('shopify:section:load', initGlobalScrollReveal);

      /* Sticky Header Scroll State Listener */
      function updateStickyHeader() {
        const header = document.querySelector('.header-overlay-wrapper');
        if (!header) return;
        if (window.scrollY > 20) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      }
      window.addEventListener('scroll', updateStickyHeader, { passive: true });
      updateStickyHeader();
    });
  </script>
</body>
</html>
